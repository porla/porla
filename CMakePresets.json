{
  "version": 4,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "PORLA_CORE_TYPE": "SHARED"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "PORLA_CORE_TYPE": "SHARED"
      }
    },
    {
      "name": "alpine-static",
      "inherits": "base",
      "cacheVariables": {
        "Boost_USE_STATIC_LIBS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-static -s",
        "CMAKE_FIND_LIBRARY_SUFFIXES": ".a",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "OPENSSL_USE_STATIC_LIBS": "TRUE",
        "PORLA_CORE_TYPE": "STATIC",
        "SQLite3_LIBRARY": "/usr/lib/libsqlite3.a",
        "SQLite3_INCLUDE_DIR": "/usr/include",
        "ZLIB_LIBRARY": "/usr/lib/libz.a"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug" },
    { "name": "release",       "configurePreset": "release" },
    { "name": "alpine-static", "configurePreset": "alpine-static" }
  ]
}
